@model GroupProject.ViewModels.ChangeDetailsViewModel;

@{
    ViewData["Title"] = "Change Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/j_stylesheet.css"/>

<div class="layout">
    @* jm: add title/header for change personal details form *@
    <div class="row g-3 align-items-center ">
        <div class="col-md-3 text-center mb-3">
            <img src="~/images/snail.png" class="mascot img-fluid" alt="Toaster Snail Mascot"
                 style="max-height: 150px; width: auto; margin:30px;"/>
        </div>
        <div class="col-md-8 text-center text-md-center">
            <h1 class="subtitlepurple">Change Personal Details</h1>
            <p>Update your personal information and profile picture.</p>
        </div>
    </div>

    @* jm: form to change personal details, including first name, last name, address, profile picture, and 2FA toggle. 
    anti-forgery token for security.
    validation summaries and input fields for each detail. 
    The form ends with Cancel and Confirm Changes buttons. *@
    <form asp-action="ChangeDetails" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="fw-bold smalltextpurple text"></div>
        
        <div class="carddustygreen rounded-bottom-0 mb-0 px-3">
            <div class="text-center mb-3 py-2">
                <h2>Personal Details</h2>
            </div>
            
            @* jm: Full name form section for editing first and last name *@
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="section mb-2">
                        <div class="section-header">
                            <span class="section-tag">
                                <h3>Full Name</h3>
                            </span>
                            <div class="section-line"></div>
                        </div>
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control"/>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control"/>
                                <span asp-validation-for="LastName" class="fw-bold smalltextpurple text"></span>
                            </div>
                        </div>
                    </div>
                    
                    @* jm: Address form section for editing address *@
                    <div class="section mb-2">
                        <div class="section-header">
                            <span class="section-tag">
                                <h3>Address</h3>
                            </span>
                            <div class="section-line"></div>
                        </div>
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label asp-for="AddressLine1" class="form-label">Address Line 1</label>
                                <input asp-for="AddressLine1" class="form-control"/>
                                <span asp-validation-for="AddressLine1" class="fw-bold smalltextpurple text"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="AddressLine2" class="form-label">Address Line 2</label>
                                <input asp-for="AddressLine2" class="form-control"/>
                                <span asp-validation-for="AddressLine2" class="fw-bold smalltextpurple text"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control"/>
                                <span asp-validation-for="City" class="fw-bold smalltextpurple text"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PostCode" class="form-label">Post Code</label>
                                <input asp-for="PostCode" class="form-control"/>
                                <span asp-validation-for="PostCode" class="fw-bold smalltextpurple text"></span>
                            </div>
                        </div>
                    </div>
                    
                    @* - 2FA toggle, codes are emailed to the address shown below when enabled *@
                    <div class="section">
                        <div class="section-header mt-2">
                            <span class="section-tag">
                                <h3>2FA</h3>
                            </span>
                            <div class="section-line"></div>
                        </div>
                        <div class="row g-3">
                            <div class="form-check">
                                <label asp-for="Is2FAEnabled" class="form-check-label">
                                    <input asp-for="Is2FAEnabled" class="form-check-input"/>
                                    @Html.DisplayNameFor(a => a.Is2FAEnabled)
                                </label>
                                <span asp-validation-for="Is2FAEnabled" class="fw-bold smalltextpurple text"></span>
                            </div>
                            <p class="small text-muted">Verification codes will be emailed to @ViewBag.MaskedEmail</p>
                        </div>
                    </div>
                </div>

                @* jm: Profile picture section *@
                <div class="col-md-4">
                    <label class="form-label fw-bold">Profile Picture</label>
                    @* jm: ratio chanegs into square*@
                    
                    <div class="upload-zone ratio ratio-1x1 mx-auto d-flex flex-column justify-content-center align-items-center p-3 overflow-hidden" id="uploadZone" onclick="document.getElementById('ProfilePicture').click()"
                         ondragover="event.preventDefault();this.classList.add('dragover')"
                         ondragleave="this.classList.remove('dragover')"
                         ondrop="handleDrop(event)">

                        @* jm: centers upload prompt, button and preview image *@
                        <div class="d-flex flex-column justify-content-center align-items-center p-3">
                            <input type="file" asp-for="ProfilePicture" class="form-control" accept="image/*"
                                   onchange="previewImage(this)"/>

                            <h6 class="fw-bold mb-1">Drop Profile Image here or click to upload</h6>
                            <button type="button" class="btn btnpurple px-4 text-white"
                                    onclick="event.stopPropagation();document.getElementById('ProfilePicture').click()">
                                Browse Photo
                            </button>

                            <div id="imagePreviewContainer" class="mt-2">
                                @if (!string.IsNullOrEmpty(Model?.ProfilePictureUrl))
                                {
                                    <img src="@Model.ProfilePictureUrl" alt="Current Profile"
                                         class="img-fluid rounded object-fit-cover" style="max-height: 120px;"/>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model?.ProfilePictureUrl))
                    {
                        <div class="form-check mt-2">
                            <input asp-for="RemoveProfilePicture" class="form-check-input"/>
                            <label asp-for="RemoveProfilePicture" class="form-check-label"></label>
                        </div>
                    }
                    <span asp-validation-for="ProfilePicture" class="fw-bold smalltextpurple text"></span>
                </div>
            </div>

            @* jm: Moved above profile picture to match other form fields, and on mobile to make layout look cleaner *@
            @* - 2FA toggle, codes are emailed to the address shown below when enabled *@
            @* <div class="col-md-8"> *@
            @*     <div class="section"> *@
            @*         <div class="section-header mt-2"> *@
            @*             <span class="section-tag"> *@
            @*                 <h3>2FA</h3> *@
            @*             </span> *@
            @*             <div class="section-line"></div> *@
            @*         </div> *@
            @*         <div class="row g-3"> *@
            @*             <div class="form-check"> *@
            @*                 <label asp-for="Is2FAEnabled" class="form-check-label"> *@
            @*                     <input asp-for="Is2FAEnabled" class="form-check-input"/> *@
            @*                     @Html.DisplayNameFor(a => a.Is2FAEnabled) *@
            @*                 </label> *@
            @*                 <span asp-validation-for="Is2FAEnabled" class="text-danger"></span> *@
            @*             </div> *@
            @*             <p class="small text-muted">Verification codes will be emailed to @ViewBag.MaskedEmail</p> *@
            @*         </div> *@
            @*     </div> *@
            @* </div> *@
        </div>
        
        @* jm: Create user and cancel button display next to each other on right side,
                different colours and sizes to highlight different option (cancel or create user).*@
        <div class="carddustygreen-footer-opacity rounded-top-0 mt-0 d-flex justify-content-end align-items-center p-3">
            <div>
                <div class="button-group d-inline-flex justify-content-end">
                    <a asp-controller="Account" asp-action="Index" class="btn btn-lg btnwhite">
                        Cancel
                    </a>
                    <button type="submit" class="btnpurple-long btn-lg">Confirm Changes</button>
                </div>
            </div>
        </div>
    </form>

    <script>
        //TL - ensures that only images are allowed to be uploaded (client-side)
        const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
        const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5 MB

        //TL - Validates passed in file is one of the types defined above
        function validateImageFile(file) {
            if (!ALLOWED_TYPES.includes(file.type)) {
                alert('Invalid file type. Please upload a JPG, PNG, or WebP image.');
                return false;
            }
            if (file.size > MAX_FILE_SIZE) {
                alert('File is too large. Maximum allowed size is 5 MB.');
                return false;
            }
            return true;
        }

        function handleDrop(event) {
            event.preventDefault();
            const zone = document.getElementById('uploadZone');
            zone.classList.remove('dragover');

            const input = document.getElementById('ProfilePicture');
            if (event.dataTransfer.files && event.dataTransfer.files.length > 0) {
                const file = event.dataTransfer.files[0];
                if (!validateImageFile(file)) {
                    input.value = ''; // Clear input
                    return;
                }
                input.files = event.dataTransfer.files;
                previewImage(input);
            }
        }

        function previewImage(input) {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '';

            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (!validateImageFile(file)) {
                    input.value = ''; // Reset invalid selection
                    container.innerHTML = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = '70px';
                    img.style.height = 'auto';
                    container.appendChild(img);
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
</div>