@model GroupProject.ViewModels.ChangeDetailsViewModel;

@{
    ViewData["Title"] = "Change Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/j_stylesheet.css"/>

<div>
    <div>
        <h2>Change Personal Details</h2>
        <form asp-action="ChangeDetails" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressLine1"></label>
                <input asp-for="AddressLine1" class="form-control" />
                <span asp-validation-for="AddressLine1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressLine2"></label>
                <input asp-for="AddressLine2" class="form-control" />
                <span asp-validation-for="AddressLine2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="City"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PostCode"></label>
                <input asp-for="PostCode" class="form-control" />
                <span asp-validation-for="PostCode" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Profile Picture</label>
                <div class="upload-zone" id="uploadZone" onclick="document.getElementById('ProfilePicture').click()"
                     ondragover="event.preventDefault();this.classList.add('dragover')"
                     ondragleave="this.classList.remove('dragover')"
                     ondrop="handleDrop(event)">

                    <input type="file" asp-for="ProfilePicture" class="form-control" accept="image/*"
                           onchange="previewImage(this)"/>

                    <h6 class="fw-bold mb-1">Drop Profile Image here or click to upload</h6>
                    <button type="button" class="btn btnpurple px-4 text-white"
                            onclick="event.stopPropagation();document.getElementById('ProfilePicture').click()">
                        Browse Photo
                    </button>

                    <div id="imagePreviewContainer" class="mt-3">
                        @if (!string.IsNullOrEmpty(Model?.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="Current Profile"
                                 style="width: 70px; height: auto;"/>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model?.ProfilePictureUrl))
                {
                    <div class="form-check mt-2">
                        <input asp-for="RemoveProfilePicture" class="form-check-input"/>
                        <label asp-for="RemoveProfilePicture" class="form-check-label"></label>
                    </div>
                }
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </div>

            @* - 2FA toggle, codes are emailed to the address shown below when enabled *@
            <div class="form-group">
                <div class="form-check">
                    <label asp-for="Is2FAEnabled" class="form-check-label">
                        <input asp-for="Is2FAEnabled" class="form-check-input" />
                        @Html.DisplayNameFor(a => a.Is2FAEnabled)
                    </label>
                    <span asp-validation-for="Is2FAEnabled" class="text-danger"></span>
                </div>
                <small class="text-muted">Verification codes will be emailed to @ViewBag.MaskedEmail</small>
            </div>

            <button type="submit" class="btn btn-primary">Confirm Changes</button>
        </form>
    </div>

    <script>
        function handleDrop(event) {
            event.preventDefault();
            const zone = document.getElementById('uploadZone');
            zone.classList.remove('dragover');

            const input = document.getElementById('ProfilePicture');
            if (event.dataTransfer.files && event.dataTransfer.files.length > 0) {
                input.files = event.dataTransfer.files;
                previewImage(input);
            }
        }

        function previewImage(input) {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '';

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = '70px';
                    img.style.height = 'auto';
                    container.appendChild(img);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</div>