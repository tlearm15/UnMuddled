@model GroupProject.ViewModels.ForgotPasswordViewModel;

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />

@* jm: main body for forgot password page, form is inside a green card *@
<main class="layout">
    <div class="carddustygreen">
        <div class="login-register-wrapper">
            <div class="login-register-form justify-content-center mb-2">
                <h2 class="text-center mb-2">Forgot Password?</h2>
                <p class="text-center mb-2">
                    We'll send you a link to reset your password
                </p>
                @* jm: form starts *@
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="fw-bold text-decoration-underline smalltextpurple"></div>
                   
                    @* jm: email input *@
                    <div class="col-12 ">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="fw-bold text-decoration-underline smalltextpurple"></span>
                    </div>
                    
                    <input type="submit" class="btn btnpurple-long w-100 text-white"/>
                    @* jm: form ends *@
                </form>
                <p class="text-center mt-2">
                    Already have an account? <a asp-controller="Account" asp-action="Login" class="fw-bold smalltextpurple">Login here</a>
                </p>
            </div>
            @* jm: snail image next to form on desktop *@
            <div class="login-register-image">
                <img src="~/images/snail.png" class="mascot" alt="Snail Toaster" />
            </div>
        </div>
    </div>
</main>