@using GroupProject.ViewModels;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet" href="~/css/j_stylesheet.css" />
<main>
    <div class="layout">
        @* jm: title and back to account button with snail mascot image. *@
        <div class="row align-items-center">
            <div class="col-md-3 text-center mb-3">
                <img src="~/images/snail.png" class="mascot img-fluid" alt="Toaster Snail Mascot" style="max-height: 150px; width: auto; margin:30px;"/>
            </div>
            <div class="col-md-8 text-center text-md-center">
                <h1 class="subtitlepurple">Change Password </h1>
                <p>Create a new secure password!</p>
            </div>
        </div>
        @* jm: green card for the password change form *@
        <div class="carddustygreen">
            <div class="login-register-wrapper">
                <div class="login-register-form">
                    @* jm: form starts *@
                    <form asp-action="ChangePassword" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="fw-bold text-decoration-underline smalltextpurple-danger"></div>
                        
                        @* jm: current password text input *@
                        <div class="col-md-12">
                            <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                            @* jm: text input for current password. JS script used to toggle password visibility by clicking eye icon *@
                            <div class="password-field">
                                <input asp-for="CurrentPassword" class="form-control" type="password" id="currentPass"/>
                                <button id="toggleConfirmBtn" type="button" class="toggleBtn" aria-label="Toggle current password visibility">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="fw-bold text-decoration-underline smalltextpurple"></span>
                        </div>

                        @* jm: New password input underneath current password *@
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label">New Password</label>
                            @* jm: text input for new password. JS script used to toggle password visibility by clicking eye icon *@
                            <div class="password-field">
                                <input asp-for="NewPassword" class="form-control" type="password" id="newPass"/>
                                <button id="toggleNewBtn" type="button" class="toggleBtn" aria-label="Toggle new password visibility">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="fw-bold text-decoration-underline smalltextpurple"></span>
                        </div>
                        
                        @* jm: Confirm new password input *@
                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                            @* jm: text input for confirm new password. JS script used to toggle password visibility by clicking eye icon *@
                            <div class="password-field">
                                <input asp-for="ConfirmNewPassword" class="form-control" type="password" id="confirmNewPass"/>
                                <button id="toggleNewConfirmBtn" type="button" class="toggleBtn" aria-label="Toggle confirm new password visibility">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="fw-bold text-decoration-underline smalltextpurple"></span>
                        </div>

                        @* jm: Cancel button *@
                        <div class="col-md-2">
                            <div>
                                <a asp-controller="Account" asp-action="Index" class="btn btn-lg btnwhite w-100">
                                    Cancel
                                </a>
                            </div>
                        </div>

                        @* jm: Change password button, submits form to change password action in account controller *@
                        <div class="col-md-10">
                            <div>
                                <button type="submit" class="btn btn-lg btnpurple w-100 text-white">Change Password</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
@* jm: javascript toggle password visibility script, lets user hide or see their password *@
<script src="~/js/togglePassword.js"></script>