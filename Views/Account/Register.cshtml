@model GroupProject.ViewModels.RegisterViewModel;

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />

<main class="layout">
    <div class="carddustygreen">
        <div class="login-register-wrapper">
            <div class="login-register-form">
                <h2 class="text-center mb-2">Register</h2>
                @* form starts *@
                <form asp-action="Register" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="fw-bold text-decoration-underline smalltextpurple-danger"></div>
                    @* <div class="mb-3"> *@
                    @*     <label asp-for="FirstName" class="form-label">First Name</label> *@
                    @*     <input asp-for="FirstName" class="form-control"/> *@
                    @*     <span asp-validation-for="FirstName" class="fw-bold text-decoration-underline smalltextpurple"></span> *@
                    @* </div> *@
                    @* <div class="mb-3"> *@
                    @*     <label asp-for="LastName" class="form-label">Last Name</label> *@
                    @*     <input asp-for="LastName" class="form-control"/> *@
                    @*     <span asp-validation-for="LastName" class="fw-bold text-decoration-underline smalltextpurple"></span> *@
                    @* </div> *@
                    <div class="col-12">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="fw-bold text-decoration-underline smalltextpurple"></span>
                    </div>
                    
                    @* jm: text input for password. JS script used to toggle password visibility by clicking eye icon *@
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="password-field">
                            <input asp-for="Password" class="form-control" type="password"  id="passInput"/>
                            <button id="toggleBtn" type="button" class="toggleBtn" aria-label="Toggle password visibility">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="fw-bold text-decoration-underline smalltextpurple"></span>
                    </div>
                    
                    @* jm: text input for confirm password. JS script used to toggle password visibility by clicking eye icon *@
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="password-field">
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPassInput"/>
                            <button id="toggleConfirmBtn" type="button" class="toggleBtn" aria-label="Toggle confirm password visibility">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="fw-bold text-decoration-underline smalltextpurple"></span>
                    </div>

                    <input type="submit" value="Register" class="btn btnpurple-long w-100 text-white"/>
                    <p class="text-center mt-2">
                        Already have an account? <a asp-controller="Account" asp-action="Login" class="fw-bold smalltextpurple">Login here</a>
                    </p>
                </form>
                @* jm: form ends *@
            </div>
            @* jm: snail image next to form on desktop *@
            <div class="login-register-image">
                <img src="~/images/snail.png" class="mascot" alt="Snail Toaster" />
            </div>
        </div>
    </div>
</main>


@* Script allows for password visibility toggling*@
<script src="~/js/togglePassword.js"></script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }   
}

