@* @model GroupProject.ViewModels.LocationViewModel *@


@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />
@* jm: leaflet CSS for map *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
@* jm: leaflet JS for map *@
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
<style>
    #map { height: 500px; width: 100%; border-radius: 8px; }
</style>

<main class="layout">
    <div class="text-center mb-2">
        <h1 class="titlepurple-var">Where to Recycle?</h1>
    </div>
    @* jm: search form *@
    <div class="row">
        <div class="col-md-4">

        </div>

        @* jm: map *@
        <div class="col-md-8">
            <div id="map"> </div>

        </div>
    </div>

</main>


<script>
    //initialise the map (defaults to Glasgow)
    var map = L.map('map').setView([55.8642, -4.2518], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    
    
</script>