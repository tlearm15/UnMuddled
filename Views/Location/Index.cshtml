@model GroupProject.ViewModels.LocationViewModel 


@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />
@* jm: leaflet CSS for map *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
@* jm: leaflet JS for map *@
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
<style>
    #map { height: 500px; width: 100%; border-radius: 8px; }
</style>

<main class="layout">
    <div class="text-center mb-2">
        <h1 class="titlepurple-var">Where to Recycle</h1>
        <p> Not sure where to recycle your item? Use our recycling locator </p>
    </div>
    <div class="container-fluid">
        <div class="row g-2">
            <div class="col-md-4 mb-4">
                <div class="carddustygreen p-4">
                    <h5>Search</h5>

                    <form asp-action="Index" method="post" id="searchForm">
                        @* jm: item selection *@
                        <div class="purple-select mb-2">
                            <label asp-for="SelectedItemId" class="form-label">Select the Item you'd like to Recycle </label>
                            <select asp-for="SelectedItemId" asp-items="Model.Items" class="form-select">
                                <option value=""> Select an Item </option>
                            </select>
                        </div>
                        @* jm: location search via user input *@
                        <div class="mb-2">
                            <label asp-for="LocationSearch" class="form-label">Enter town or postcode</label>
                            <input asp-for="LocationSearch" class="form-control"/>
                        </div>
                        
                        @* jm: location search via user's saved address using check box 
                           TODO: Logic to only show this if user is logged in and has address *@
                        <div class="form-check mb-4">
                            <input asp-for="UseSavedAddress" class="form-check-input" type="checkbox" id="useSavedAddress" role="switch"/>
                            <label class="form-check-label" for="useSavedAddress">
                                Use my saved address
                            </label>
                        </div>
                        
                        @* jm: hidden fields for geolocation *@
                        <input type="hidden" asp-for="Latitude" id="Latitude"/>
                        <input type="hidden" asp-for="Longitude" id="Longitude"/>

                        @* jm: location search via user's current address using check box *@
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="useCurrentLocation" onchange="toggleCurrentLocation(this)" />
                            <label class="form-check-label" for="useCurrentLocation">
                                Use my current location
                            </label>
                        </div>
                        
                        @* jm: button submits form and findings locations near them *@
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btnpurple btn-lg">Search</button>
                        </div>
                    </form>
                </div>
            </div>

            @* jm: map *@
            <div class="col-md-8">
                <div class="card">
                    <div id="map"> </div>
                </div>


            </div>
        </div>
    </div>

</main>

@* JM: TODO JS LOGIC FOR leaflet *@
<script>
    //initialise the map (defaults to Glasgow)
    var map = L.map('map').setView([55.8642, -4.2518], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    
    
</script>