@{
    ViewData["Title"] = "About UnMuddled";
}

<link rel="stylesheet" href="~/css/M_StyleSheet.css" />

<div>

    <img src="~/images/logo_full.png" class="logofull" alt="Snail Toaster Mascot" style="margin: 0 auto;" />
    <br />

    <h1 class="titlegreen">About UnMuddled</h1>

    <hr class="linepurple" />


    <div class="cardlightgreen" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; padding: 20px;">

        <div style="flex: 1;">
            <p class="subtitlepurple">Recycling Made Accessible</p>
            <p>Year by year people dispose of E-Waste products incorrectly, without knowing:</p>
            <ul>
                <li>How to recycle these products</li>
                <li>Where to recycle these products</li>
                <li>What the recycling symbols related to E-Waste products refer to</li>
            </ul>
            
            <p class="subtitlepurple">UnMuddled</p>
            <p>This is where UnMuddled comes in, the UnMuddled website aims to unmuddle the recycling system. <br>
                Making recycling E-Waste simple, clear and overall accessible.
            </p>

        </div>

        <div style="text-align: center; min-width: 250px;">
            <img src="~/images/snail.png" class="mascot" alt="Snail Toaster Mascot" style="margin: 0 auto;" />
            <p class="smalltextpurple" style="font-weight: bold; margin-top: 10px;">Recycling Shouldn't be a Muddle</p>
        </div>

    </div>

    <div class="cardpurple" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; padding: 20px;">

        <div style="text-align: center; min-width: 280px; margin: 20px auto; flex: 1;">
            <img src="~/images/logo_cord.png" class="logocord" alt="UnMuddled Cord Logo" style="margin: 0 auto;" />
        </div>

        <div style="flex: 1; min-width: 280px; padding-left: 20px;">

            <p class="subtitlegreen" style="justify-content: flex-start; margin-bottom: 15px;">About The UnMuddled Team</p>

            <p>UnMuddled was created by a team of Year 3 Computer Science and Software Development Students as a part of our Group Project.</p>

            <br>

            <p> We wanted to make E-Waste recycling more accessible and to tackle a real world problem.</p>

            <br>

            <p class="smalltextgreen" style="font-style: italic; font-weight: bold; padding:0px !important;">Recycling shouldn't be a muddle.</p>

        </div>

    </div>


</div>
