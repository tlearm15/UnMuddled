@model IEnumerable<GroupProject.Models.User>

@{
    ViewData["Title"] = "Admin Dashboard";
    //m user history items passed via ViewBag or query
    var recycledItems = ViewBag.RecycledItems as IEnumerable<GroupProject.Models.UserHistoryItem> ?? Enumerable.Empty<GroupProject.Models.UserHistoryItem>();
}

<link rel="stylesheet" href="~/css/M_StyleSheet.css"/>

<div class="container-fluid mt-4 px-4">

    @*m dashboard title banner *@
    <div>
        <div class="row align-items-center text-center text-md-start">
            <div class="col-md-12 d-flex align-items-center justify-content-center justify-content-md-start gap-3">
                <img src="~/images/snail.png" class="mascotsmall" alt="Mudd the Toaster Snail Mascot" style="width: auto;" />
                <h1 class="titlepurple fw-bold">Dashboard</h1>
            </div>
        </div>
    </div>

    <hr class="linepurple"/>

    <div class="row">
        @*m link for approve item requests needs updated when the approve item requests page is created *@
        @*m sidebar menu for admin feutures *@
        <div class="col-lg-3 mb-4">
            <div class="menu-card">
                <a asp-controller="Admin" asp-action="Index" class="menu-item menu-item-active">Dashboard</a>
                <a asp-controller="Request" asp-action="Index" class="menu-item">Approve Item Requests</a>
                <a asp-controller="Request" asp-action="Index" class="menu-item">Add Items</a>
                <a asp-controller="Item" asp-action="EditAndDelete" class="menu-item">Edit &amp; Delete Items</a>
                <a asp-controller="Admin" asp-action="CreateNewUser" class="menu-item">Create User Account</a>
                <a asp-controller="Admin" asp-action="UserList" class="menu-item">See List of All User Accounts</a>
            </div>
        </div>


        <div class="col-lg-9">
            <div class="row">

                @*m user management *@
                <div class="col-md-6 mb-4">
                    <div class="card cardpurple h-100">
                        <h3 class="subtitlepurple text-center fw-bold mb-1">User Management</h3>
                        <p class="smalltextpurple text-center">Please select the user to be permanently deleted</p>

                        <hr class="linepurple" />

                        @*m form for linking admin delete *@
                        <form asp-controller="Admin" asp-action="DeleteUser" method="get">

                            @*m list of users *@
                            <div class="bg-white border rounded p-2" style="max-height: 350px; overflow-y: auto;">
                                @if (Model == null || !Model.Any())
                                {
                                    <p class="smalltextpurple text-center mt-5">No users found</p>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var user in Model)
                                        {
                                            <label class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2" style="cursor: pointer;">
                                                <input type="radio" name="id" value="@user.Id" class="form-check-input mt-0" required />

                                                <span class="smalltextpurple">@user.FirstName @user.LastName (@user.Email)</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>

                            @*m delete submit button *@
                            <button type="submit" class="btnpurple-long-big w-100">
                                Delete User Account
                            </button>
                        </form>

                    </div>
                </div>

                @*m recently recycled items card *@
                <div class="col-md-6 mb-4">
                    <div class="card cardpurple h-100 p-4">
                        <h3 class="subtitlepurple text-center fw-bold mb-1">Recently Recycled Items</h3>
                        <p class="smalltextpurple text-center">A list of items that users have logged as recently recycled</p>

                        <hr class="linepurple" />

                        @*m box for all suers items *@
                        <div class="bg-white border rounded p-3" style="max-height: 350px; overflow-y: auto;">

                            @if (!recycledItems.Any())
                            {
                                <p class="smalltextpurple text-center mt-5">No items have been logged as recycled yet</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var historyItem in recycledItems)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-1 py-2">
                                            <span class="smalltextpurple">
                                                <strong>@(historyItem.Item?.ItemName ?? "Unknown Item")</strong>
                                                - @(historyItem.UserHistory?.User?.FirstName ?? "User") @(historyItem.UserHistory?.User?.LastName ?? "")
                                            </span>
                                            <span class="badge rounded-pill" style="background-color: #93A3A2;">
                                                @historyItem.DateDisposed
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>
</div>