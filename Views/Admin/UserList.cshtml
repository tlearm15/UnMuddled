@model List<User>

<h2>User List</h2>

@if (TempData["ErrorMessage"] != null)
{
    <p>@TempData["ErrorMessage"]</p>
}

<p>
    <a asp-controller="Admin" asp-action="CreateNewUser">
        Create New User
    </a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>@user.UserRole</td>
                <td>
                    <a asp-controller="Admin"
                       asp-action="UserDetails"
                       asp-route-id="@user.Id">
                        Details
                    </a>

                    <a asp-controller="Admin"
                       asp-action="EditUserRole"
                       asp-route-id="@user.Id">
                        Change Role
                    </a>

                    <a asp-controller="Admin"
                       asp-action="DeleteUser"
                       asp-route-id="@user.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

