@using GroupProject.ViewModels
@model CreateStaffViewModel

@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />


<main class="layout my-4">
    <div>
        @* jm: form starts, using Bootstrap form grid with gutters to control width*@
        <form asp-controller="Admin" asp-action="CreateNewUser" method="post" class="mb-1">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="fw-bold smalltextpurple text"></div>

            @* jm: green card starts *@
            <div class="carddustygreen rounded-bottom-0 mb-0">
                <div class="text-center">
                    <h1 class="titlepurple-var">Create a New User</h1>
                </div>
                @* jm: account details section *@
                <div class="section">
                    <div class="section-header">
                        <span class="section-tag">
                            <h3>Account Details</h3>
                        </span>
                        <div class="section-line"></div>
                    </div>
                    <div class="row g-3">
                        @* jm: text input for first name *@
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control"/>
                            <span asp-validation-for="FirstName" class="fw-bold smalltextpurple text"></span>
                        </div>
                        @* jm: text input for last name *@
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control"/>
                            <span asp-validation-for="LastName" class="fw-bold smalltextpurple text"></span>
                        </div>
                        @* jm: text input for email *@
                        <div class="col-md-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control"/>
                            <span asp-validation-for="Email" class="fw-bold smalltextpurple text"></span>
                        </div>
                        @* jm: text input for password. JS script used to toggle password visibility by clicking eye icon *@
                        <div class="col-md-12">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="password-field">
                                <input asp-for="Password" class="form-control" id="passInput"/>
                                <button id="toggleBtn" type="button" class="toggleBtn" aria-label="Toggle password visibility">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                    </svg>
                                </button>
                            </div>
                            @* jm: checks if there's multiple errors for password field and lists them all *@
                            @* jm: Loop through and display all server-side errors for the Password field *@
                            @if (ViewData.ModelState.TryGetValue("Password", out var pwdState) && pwdState.Errors.Count > 0)
                            {
                                <div class="fw-bold smalltextpurple text mt-1">
                                    <ul class="mb-0 ps-4">
                                        @foreach (var error in pwdState.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                @* jm: Fallback for client-side validation before the form is submitted *@
                                <span asp-validation-for="Password" class="fw-bold smalltextpurple text"></span>
                            }
                        </div>
                        @* jm: selection for the user's role *@
                        <div class="purple-select">
                            <label asp-for="UserRole" class="form-label"></label>
                            <select class="form-select" asp-for="UserRole"
                                    asp-items="Html.GetEnumSelectList<UserRole>()">
                            </select>
                            <span asp-validation-for="UserRole" class="fw-bold smalltextpurple text"></span>
                        </div>
                    </div>
                </div>
                @* jm: address section *@
                <div class="section mb-2">
                    <div class="section-header">
                        <span class="section-tag">
                            <h3>Address</h3>
                        </span>
                        <div class="section-line"></div>
                    </div>
                    <div class="row g-3">
                        @* jm: text input for address *@
                        <div class="col-md-6">
                            <label asp-for="AddressLine1" class="form-label"></label>
                            <input asp-for="AddressLine1" class="form-control"/>
                            <span asp-validation-for="AddressLine1" class="fw-bold smalltextpurple text"></span>
                        </div>

                        @* jm: text input for address - optional *@
                        <div class="col-md-6">
                            <label asp-for="AddressLine2" class="form-label"></label>
                            <input asp-for="AddressLine2" class="form-control"/>
                            <span asp-validation-for="AddressLine2" class="fw-bold smalltextpurple text"></span>
                        </div>

                        @* jm: text input for city *@
                        <div class="col-md-8">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control"/>
                            <span asp-validation-for="City" class="fw-bold smalltextpurple text"></span>
                        </div>
                        
                        @* jm: text input for post code *@
                        <div class="col-md-4">
                            <label asp-for="PostCode" class="form-label"></label>
                            <input asp-for="PostCode" class="form-control"/>
                            <span asp-validation-for="PostCode" class="fw-bold smalltextpurple text"></span>
                        </div>
                        
                    </div>
                </div>
                @* jm: card end *@
            </div>
            @* jm: Create user and cancel button display next to each other on right side,
                different colours and sizes to highlight different option (cancel or create user).*@
            <div class="carddustygreen-footer-opacity rounded-top-0 mt-0 d-flex justify-content-end align-items-center p-3">
                <div>
                    <div class="button-group d-inline-flex justify-content-end">
                        <a asp-controller="Admin" asp-action="UserList" class="btn btn-lg btnwhite">
                            Cancel
                        </a>
                        <button type="submit" class="btnpurple-long btn-lg">Create User</button>
                    </div>
                </div>
            </div>
            @* jm: form ends *@
        </form>
    </div>
</main>

@* jm: javascript toggle password visibility script, lets user hide or see their password *@
<script src="~/js/togglePassword.js"></script>