@using GroupProject.ViewModels
@model CreateStaffViewModel

<h2>Create New User</h2>

<form asp-controller="Admin" asp-action="CreateNewUser" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName"></span>
    </div>

    <div>
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
    </div>

    <h3>Address</h3>

    <div>
        <label asp-for="AddressLine1"></label>
        <input asp-for="AddressLine1" />
        <span asp-validation-for="AddressLine1"></span>
    </div>

    <div>
        <label asp-for="AddressLine2"></label>
        <input asp-for="AddressLine2" />
        <span asp-validation-for="AddressLine2"></span>
    </div>

    <div>
        <label asp-for="City"></label>
        <input asp-for="City" />
        <span asp-validation-for="City"></span>
    </div>

    <div>
        <label asp-for="PostCode"></label>
        <input asp-for="PostCode" />
        <span asp-validation-for="PostCode"></span>
    </div>

    <h3>Account Details</h3>

    <div>
        <label asp-for="UserRole"></label>
        <select asp-for="UserRole"
                asp-items="Html.GetEnumSelectList<UserRole>()">
        </select>
        <span asp-validation-for="UserRole"></span>
    </div>

    <div>
        <label asp-for="JoinedOn"></label>
        <input asp-for="JoinedOn" type="date" />
        <span asp-validation-for="JoinedOn"></span>
    </div>

    <br />

    <button type="submit">Create User</button>

    <a asp-controller="Admin" asp-action="UserList">
        Cancel
    </a>

</form>

