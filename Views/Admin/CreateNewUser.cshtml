@using GroupProject.ViewModels
@model CreateStaffViewModel

@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />


<main class="layout align-items-center align-content-center">
    <div class="text-center">
        <h2>Create a New User</h2>
    </div>
    <div class="carddustygreen d-flex justify-content-center align-items-center w-100">
        <form asp-controller="Admin" asp-action="CreateNewUser" method="post" class="row mb-1 gx-2 gy-2 col-8">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="fw-bold smalltextpurple text"></div>
            
            <h3 class="py-2">Account Details</h3>
            
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control"/>
                <span asp-validation-for="FirstName" class="fw-bold smalltextpurple text"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control"/>
                <span asp-validation-for="LastName" class="fw-bold smalltextpurple text"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control"/>
                <span asp-validation-for="Email" class="fw-bold smalltextpurple text"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Password" class="form-label"></label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" id="passInput"/>
                    <button id="toggleBtn" type="button" class="toggleBtn" aria-label="Toggle password visibility">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="fw-bold smalltextpurple text"></span>
            </div>
            
            <div class="purple-select">
                <label asp-for="UserRole" class="form-label"></label>
                <select class="form-select" asp-for="UserRole"
                        asp-items="Html.GetEnumSelectList<UserRole>()">
                </select>
                <span asp-validation-for="UserRole" class="fw-bold smalltextpurple text"></span>
            </div>
            
            <h3>Address</h3>

            <div class="col-md-6">
                <label asp-for="AddressLine1" class="form-label"></label>
                <input asp-for="AddressLine1" class="form-control"/>
                <span asp-validation-for="AddressLine1" class="fw-bold smalltextpurple text"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="AddressLine2" class="form-label"></label>
                <input asp-for="AddressLine2" class="form-control"/>
                @* <span asp-validation-for="AddressLine2"></span> *@
            </div>

            <div class="col-md-4">
                <label asp-for="PostCode" class="form-label"></label>
                <input asp-for="PostCode" class="form-control"/>
                <span asp-validation-for="PostCode" class="fw-bold smalltextpurple text"></span>
            </div>
            
            <div class="col-md-8">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control"/>
                <span asp-validation-for="City" class="fw-bold smalltextpurple text"></span>
            </div>
            
            <br />

            <div class="button-group d-inline-flex justify-content-end">
                <a asp-controller="Admin" asp-action="UserList" class="btn btnwhite">
                    Cancel
                </a>
                <button type="submit" class="btnpurple-long">Create User</button>
            </div>
        </form>
    </div>
</main>

<script src="~/js/togglePassword.js"></script>