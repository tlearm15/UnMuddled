@model GroupProject.Models.Request
@{
    ViewData["Title"] = $"Request #{Model.RequestID}";
}

<link rel="stylesheet" href="~/css/j_stylesheet.css"/>

@* jm: Request details view with basic information and action buttons, centers children elements*@
<div class="container layout align-items-center">
    @* jm: Centers the content both horizontally and vertically *@
    <div class="row justify-content-center w-100">
        <div class="col-md-10">
            
            <h2 class="subtitlepurple text-center">Request #@Model.RequestID</h2>
            
            @* jm: Card contains Request details and Reject/Approve button *@
            <div class="cardpurple p-4">
                <dl class="row mb-4">
                    
                    <div class="col-12 d-flex justify-content-center gap-2 mb-3">
                        <dt class="mb-0">@Html.DisplayNameFor(m => m.User)</dt>
                        <dd class="mb-0">@Model.User?.Email</dd>
                    </div>

                    <div class="col-12 d-flex justify-content-center gap-2 mb-3">
                        <dt class="mb-0">@Html.DisplayNameFor(m => m.ItemName)</dt>
                        <dd class="mb-0">@Model.ItemName</dd>
                    </div>

                    <div class="col-12 d-flex justify-content-center gap-2 mb-3">
                        <dt class="mb-0">@Html.DisplayNameFor(m => m.Category)</dt>
                        <dd class="mb-0">@Model.Category?.CategoryName</dd>
                    </div>

                    <div class="col-12 d-flex justify-content-center gap-2 mb-3">
                        <dt class="mb-0">@Html.DisplayNameFor(m => m.RecyclingLocations)</dt>
                        <dd class="mb-0">@Model.RecyclingLocations</dd>
                    </div>

                    <div class="col-12 d-flex justify-content-center gap-2 mb-3">
                        <dt class="mb-0">@Html.DisplayNameFor(m => m.Status)</dt>
                        <dd class="mb-0">@Model.Status</dd>
                    </div>

                    <div class="col-12 d-flex justify-content-center gap-2 mb-0">
                        <dt class="mb-0">@Html.DisplayNameFor(m => m.SubmittedOn)</dt>
                        <dd class="mb-0">@Model.SubmittedOn.ToLocalTime().ToShortDateString()</dd>
                    </div>
                </dl>

                @if (Model.Status == RequestStatus.Pending)
                {
                    <div class="d-flex justify-content-center gap-2">
                        <form asp-action="Reject" asp-route-id="@Model.RequestID" method="post" class="d-inline">
                            <button type="submit" class="btn btnpurple">Reject</button>
                        </form>
                        <form asp-action="Approve" asp-route-id="@Model.RequestID" method="post" class="d-inline">
                            <button type="submit" class="btn btndustygreen">Approve</button>
                        </form>
                    </div>
                }
            </div>
            
            <div class="d-flex justify-content-center">
                <a asp-action="ListRequests" style="color: #242926">Back to Requests</a>
            </div>
        </div>
    </div>
</div>