@model List<GroupProject.Models.Request>
@{
    ViewData["Title"] = "Requests";
}

<link rel="stylesheet" href="~/css/j_stylesheet.css"/>

<div class="layout">
    <h2 class="text-center subtitlepurple">Item Requests</h2>
    <div class="table-responsive-md">

        <table class="table align-middle mb-0 table-hover">
            <caption>List of item requests.</caption>
            <thead class="thead-purple">
            <tr>
                <th>@Html.DisplayNameFor(m => m[0].RequestID)</th>
                <th>@Html.DisplayNameFor(m => m[0].User)</th>
                <th>@Html.DisplayNameFor(m => m[0].ItemName)</th>
                <th>@Html.DisplayNameFor(m => m[0].Category)</th>
                <th>@Html.DisplayNameFor(m => m[0].Status)</th>
                <th>@Html.DisplayNameFor(m => m[0].SubmittedOn)</th>
                <th></th>
            </tr>
            </thead>
            <tbody style="background-color: #B6A6B8">
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.RequestID</td>
                    <td>@request.User?.Email</td>
                    <td>@request.ItemName</td>
                    <td>@request.Category?.CategoryName</td>
                    <td>@request.Status</td>
                    <td>@request.SubmittedOn.ToShortDateString()</td>
                    <td>
                        <a asp-action="ViewRequest" asp-route-id="@request.RequestID" style="color: #242926">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>