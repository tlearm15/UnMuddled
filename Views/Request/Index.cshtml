@model GroupProject.Models.Request

@{
    ViewData["Title"] = "Request a new item";
}
@* jm: added styling sheet for components *@
<link rel="stylesheet" href="~/css/j_stylesheet.css" />

<main class="layout align-items-center align-content-center">
    <div class="text-center">
        <h1 class="titlepurple-var">Request a new item</h1>
        <p class="subtitlepurple">Can't find an item? Tell us about it and we'll review it.</p>
    </div>

    @* Success / Error TempData *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show w-50 mx-auto" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show w-50 mx-auto" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="cardpurple d-flex justify-content-center align-items-center w-100">
        <form asp-action="Index" method="post" enctype="multipart/form-data"
              class="row gx-2 gy-2 col-8">
            <div asp-validation-summary="ModelOnly" class="fw-bold smalltextgreen text"></div>

            @* jm: Item Name text input *@
            <div class="col-12 purple-select">
                <label asp-for="ItemName" class="form-label"></label>
                <input asp-for="ItemName" class="form-control"/>
                <span asp-validation-for="ItemName" class="fw-bold smalltextgreen text"></span>
            </div>
            @* jm: Category drop down list, user can select category for requested item *@
            <div class="col-md-6 purple-select">
                <label asp-for="CategoryID" class="form-label"></label>
                <select asp-for="CategoryID" class="form-select" asp-items="ViewBag.Categories">
                    <option value=""> Select a category </option>
                </select>
                <span asp-validation-for="CategoryID" class="fw-bold smalltextgreen text"></span>
            </div>
            
            @* jm: Room tag drop down list, user can select room tag for requested item *@
            @*jm- temp until form is fixed by BE *@
            <div class="col-md-6 purple-select">
                <label asp-for="RoomTag" class="form-label"></label>
                <select asp-for="RoomTag" class="form-select" asp-items="ViewBag.RoomTags">
                    <option value=""> Select a Room </option>
                </select>
                <span asp-validation-for="RoomTag" class="fw-bold smalltextgreen text"></span>
            </div>
            
            <div class="col-12-3">
                <label asp-for="RecyclingLocations" class="form-label"></label>
                <textarea asp-for="RecyclingLocations" class="form-control" rows="3"
                          placeholder="e.g. Tesco recycling point, High Street"></textarea>
                <span asp-validation-for="RecyclingLocations" class="fw-bold smalltextgreen text"></span>
            </div>

            @* Multi-image upload with live preview *@
            <div class="col-12-3">
                <div class="upload-zone p-4 text-center border rounded" id="uploadZone" onclick="document.getElementById('imageFiles').click()"
                     ondragover="event.preventDefault();this.classList.add('dragover')"
                     ondragleave="this.classList.remove('dragover')"
                     ondrop="handleDrop(event)">
                    
                    <label for="imageFiles" class="form-label">Upload photos of your item here (optional)</label>
                    <input type="file" name="imageFiles" id="imageFiles" class="form-control d-none" accept="image/*" multiple onchange="previewImages(this)" />
                    
                    <h6 class="fw-bold mb-1">Drop Images here or click to upload</h6>
                    <button type="button" class="btn btnpurple px-4 text-white mb-3"
                            onclick="event.stopPropagation();document.getElementById('imageFiles').click()">
                        Upload Photos
                    </button>

                    @* Preview *@
                    <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 justify-content-center mt-3"></div>
                </div>
            </div>

            @* jm: Submits request item form *@
            <button type="submit" class="btn btnpurple-long w-100 text-white">Submit request</button>
        </form>
    </div>
</main>

<script>
    function handleDrop(event) {
        event.preventDefault();
        const zone = document.getElementById('uploadZone');
        zone.classList.remove('dragover');

        const input = document.getElementById('imageFiles');
        if (event.dataTransfer.files && event.dataTransfer.files.length > 0) {
            input.files = event.dataTransfer.files;
            previewImages(input);
        }
    }

    function previewImages(input) {
        const container = document.getElementById('imagePreviewContainer');
        container.innerHTML = ''; // Clear previous previews

        if (input.files) {
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = '80px';
                    img.style.height = '80px';
                    img.style.objectFit = 'cover';
                    img.className = 'rounded border shadow-sm';
                    container.appendChild(img);
                }
                reader.readAsDataURL(file);
            });
        }
    }
</script>