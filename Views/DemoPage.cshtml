@{
    ViewData["Title"] = "Home Page";
}

@* this is a demo page for styles, this does not need to be linked to anything
 *@

<link rel="stylesheet" href="~/css/M_StyleSheet.css" />

<h1 class="unmuddled">UnMuddled</h1>

<div class="text">
    <h1 class="titlegreen">Title - Green</h1>
    <h1 class="titlegreen-var">Title Variant - Green</h1>
    <h1 class="subtitlegreen">Subtitle - Green</h1>
    <h1 class="smalltextgreen">small text</h1>
    <h1 class="tinytextgreen">tiny text</h1>
    <hr class="linegreen" />
    <hr class="linepurple"/>
    <h1 class="titlepurple">Title - Purple</h1>
    <h1 class="titlepurple-var">Title Variant - Purple</h1>
    <h1 class="subtitlepurple">Subtitle - Purple</h1>
    <h1 class="smalltextpurple">small text</h1>
    <h1 class="tinytextpurple">tiny text</h1>
</div>


<section class="cardlightgreen">
    <p>this is card 1, light green</p>
</section>

<section class="carddustygreen">
    <p>this is card 2, dusty green</p>
</section>

<section class="cardpurple">
    <p>this is card 3, purple</p>
</section>

<section class="cardnobg">
    <p>this has no card background</p>
</section>

<button class="btndustygreen" type="button">hello</button>
<br />
<button class="btndustygreen-long" type="button">hello</button>
<br />
<button class="btnpurple" type="button">hello</button>
<br />
<button class="btnpurple-long" type="button">hello</button>

<img src="~/images/logo_full.png" class="logofull" />
<img src="~/images/logo_circle.png" class="logocircle"/>
<img src="~/images/logo_cord.png" class="logocord" />
<img src="~/images/logo_snail.png" class="logosnail" />
<img src="~/images/plainlogo.png" class="logotext" />

<img src="~/images/snail.png" class="mascot" />
<img src="~/images/snail.png" class="mascotsmall" />
<img src="~/images/snail.png" class="mascotbig" />
