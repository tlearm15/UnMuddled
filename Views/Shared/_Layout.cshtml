<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GroupProject</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/GroupProject.styles.css" asp-append-version="true"/>
</head>
<body>
    @*m top announcement marquee bar with border class removed to eliminate the white line gap*@
    <div class="marquee">
        <div class="marquee-container">
            <div class="marquee-content">
                <span>UnMuddled aims to make it easier for people to depose of their E-Waste</span>
                <span>Any Questions? Contact Us via our details on our Contact Page</span>
                <span>Recycling E-Waste shouldn't be a muddle</span>
                <span>Are we missing an item? Request an item via the Nav Bar</span>
                <span>UnMuddled aims to make it easier for people to depose of their E-Waste</span>
                <span>Any Questions? Contact Us via our details on our Contact Page</span>
                <span>Recycling E-Waste shouldn't be a muddle</span>
                <span>Are we missing an item? Request an item via the Nav Bar</span>
            </div>
        </div>
    </div>
<header>

    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand p-0" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo_full.png" alt="UnMuddled Logo" style="height: 70px; width: auto; object-fit: contain; margin-left: 50px" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">

@*                     M these all do not link to the right place as there no pages for these yet
 *@
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">How to Recycle</a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Where to Recycle</a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Symbols">Symbols</a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">About</a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Contact</a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">FAQ</a>
                    </li>

@*                     M links to the request an item page
 *@
                    <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Request" asp-action="Index">Request an Item</a>
                    </li>
@*                     M link to login partial which is right aligned
 *@                        <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - GroupProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>