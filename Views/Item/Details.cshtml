<form asp-controller="History" asp-action="AddToHistory" method="post" class="mt-3">
    <!--WM - getting the id for the current item-->
    <input type="hidden" name="itemId" value="@Model.ItemID" />

    <!--WM button to submit the item-->
    <button type="submit" class="btn btn-secondary text-white w-100 mb-2" style="background-color: #5a4b5e; border-color: #4a3b4e;">
        I Have Recycled This Recently!
    </button>
    <small class="form-text text-muted">
        clicking this will add the item to your recently recycled profile.
    </small>
</form>