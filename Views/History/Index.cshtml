@model IEnumerable<GroupProject.Models.Item>

@{
    ViewData["Title"] = "My Recycling History";
}

<h1>My Recycling History</h1>

<!-- WM - display a message if there's no recycling history to work with-->
@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't recycled any items yet
    </div>
}
else
{
    <table class="table table-striped table-hover mt-4">
        <thead class="table-dark">
            <tr>
                <th>Item Details</th>
                <th>Category</th>
                <th>Disposal Location</th>
                <th>Date Disposed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <!-- WM - using a loop for the items in the model to display those items and their details-->
            @foreach (var item in Model)
            {
                var disposal = item.ItemDisposals?.FirstOrDefault()?.DisposalLocation;

                <tr>
                    <td>
                        <strong>@item.ItemName</strong><br />
                        <small class="text-muted">@item.Description</small>
                    </td>
                    <td>@(item.Category?.CategoryName ?? "Uncategorized")</td>
                    <td>
                        <!--WM - displaying the disposal location if it's there otherwise say it's not specified-->
                        @if (disposal != null)
                        {
                            @disposal.LocationName
                            <br />
                            <small class="text-muted">@disposal.Town, @disposal.Postcode</small>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Location not specified</span>
                        }
                    </td>
                    <!--WM - displaying the date added for the item-->
                    <td>@item.DateAdded.ToString("d")</td>
                    <td>
                        <!-- WM - delete button to remove the item from the user's history' -->
                        <form asp-controller="History" asp-action="RemoveFromHistory" method="post" onsubmit="return confirm('do you really want to remove this item from your recycling history?');">
                            <input type="hidden" name="itemId" value="@item.ItemID" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}